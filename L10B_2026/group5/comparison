        <div class="comparison-container">
            
            <!-- Колонка ChatGPT -->
            <div class="comp-column chatgpt-comp-bg">
                <h2 class="column-title">ChatGPT</h2>
                <ul class="points-list">
                    <li>Відсутній візуальний дизайн.</li>
                    <li>Контент: дуже базовий та тезовий.</li>
